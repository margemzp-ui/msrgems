{
    "name":  "facescreen-recorder",
    "version":  "0.8.1",
    "description":  "Frameless screen and webcam recorder for Windows",
    "main":  "electron-main.js",
    "author":  "FaceScreen",
    "license":  "MIT",
    "scripts":  {
                    "dev":  "electron .",
                    "start":  "electron .",
                    "dist:win":  "electron-builder --win nsis"
                },
    "devDependencies":  {
                            "electron":  "^37.2.6",
                            "electron-builder":  "^26.0.12"
                        },
    "build":  {
                  "appId":  "com.facescreen.recorder",
                  "productName":  "FaceScreen Recorder",
                  "files":  [
                                "electron-main.js",
                                "electron-preload.js",
                                "studio.html",
                                "studio.css",
                                "studio.js",
                                "webcam.html",
                                "webcam.css",
                                "webcam.js",
                                "source-picker.html",
                                "source-picker.css",
                                "source-picker.js"
                            ],
                  "win":  {
                              "target":  "nsis"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true
                           }
              }
}
