{
  "manifest_version": 3,
  "name": "Facescreen Recorder",
  "version": "0.3.0",
  "description": "Private screen, camera, and picture-in-picture recording in Chrome.",
  "action": {
    "default_title": "Open Facescreen Recorder",
    "default_popup": "popup.html"
  },
  "permissions": ["downloads", "storage", "unlimitedStorage", "windows", "tabs"],
  "background": {"service_worker": "background.js"},
  "commands": {
    "_execute_action": {
      "suggested_key": {"default": "Ctrl+Shift+X", "mac": "Command+Shift+X"}
    }
  }
}
